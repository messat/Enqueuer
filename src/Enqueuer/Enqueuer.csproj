<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (framework, nullable, usings, warnings) come from /Directory.Build.props -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generic Host: configuration, dependency injection and logging -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- ValidateDataAnnotations(): checks [Required], [RegularExpression] etc. on options classes -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- IHttpClientFactory and the standard retry and timeout handler, for the Azure DevOps call -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- QueueClient, for sending the scan requests to scan-nightly -->
    <PackageReference Include="Azure.Storage.Queues" />
    <!-- DefaultAzureCredential: the job's managed identity in Azure, with no secret -->
    <PackageReference Include="Azure.Identity" />
    <!-- Plugs Serilog into the host as the logger behind ILogger<T> -->
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <!-- Serilog output to the console (stdout), which Container Apps collects -->
    <PackageReference Include="Serilog.Sinks.Console" />
    <!-- One JSON object per log line outside Development, for Log Analytics (ENQ-ADR-002) -->
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <!-- Lets the test project call internal members, such as Program.RunAsync -->
  <ItemGroup>
    <InternalsVisibleTo Include="Enqueuer.Tests" />
  </ItemGroup>

  <!-- Copy the settings files next to the built app, where the host looks for them -->
  <ItemGroup>
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
