# The enqueuer container's settings, read by docker run --env-file .env (README: Run in a container).
# Copy this file to .env, which git ignores, and replace each <...> with the real value. Save it as UTF-8.
# One NAME=value per line, with no quotes: Docker keeps quotes as part of the value.
Enqueuer__Queue__Name=scan-nightly
Enqueuer__Queue__ConnectionString=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=<azurite-account-key>;QueueEndpoint=http://host.docker.internal:10001/devstoreaccount1;
Enqueuer__AzureDevOps__OrganizationUrl=https://dev.azure.com/BlacklightInternalsMo
Enqueuer__AzureDevOps__Pat=<pat>
